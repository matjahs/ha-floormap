{
  "name": "sunflow-floorplan-card",
  "version": "0.1.0",
  "description": "Home Assistant Lovelace card with dynamic floorplan lighting from SweetHome3D models",
  "type": "module",
  "main": "dist/sunflow-floorplan-card.js",
  "module": "dist/sunflow-floorplan-card.js",
  "exports": {
    ".": "./dist/sunflow-floorplan-card.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "sunflow-floorplan": "./dist/cli/import.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./src/card.ts",
    "./dist/sunflow-floorplan-card.js"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "playground": "vite --config vite.playground.config.ts",
    "playground:sync": "bash scripts/playground-sync.sh",
    "playground:blender": "bash scripts/export-appartement.sh",
    "build": "node node_modules/@typescript/native/bin/tsc --noEmit && vite build && npm run build:cli",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "build:cli": "esbuild cli/import.ts --bundle --platform=node --format=esm --outfile=dist/cli/import.mjs --packages=external && node -e \"import('node:fs').then(fs=>{const b=fs.readFileSync('dist/cli/import.mjs');fs.writeFileSync('dist/cli/import.js','#!/usr/bin/env node\\n'+b);fs.chmodSync('dist/cli/import.js',0o755);})\"",
    "start:cli": "node --import tsx cli/import.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"cli/**/*.ts\" \"tests/**/*.ts\" \"dev/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"cli/**/*.ts\" \"tests/**/*.ts\" \"dev/**/*.ts\""
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "floorplan",
    "sweethome3d",
    "lighting"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/matjahs/ha-floormap"
  },
  "dependencies": {
    "@babylonjs/core": "^7.54.3",
    "@babylonjs/loaders": "^7.54.3",
    "custom-card-helpers": "^1.9.0",
    "fflate": "^0.8.2",
    "lit": "^3.2.1",
    "three": "^0.172.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "@types/three": "^0.172.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "yaml": "^2.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
